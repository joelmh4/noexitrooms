# Copia este archivo como .env y rellena los valores. El .env nunca se sube a Git.
PORT=3000

# Base de datos MongoDB: en local la de tu ordenador; en producción, la de MongoDB Atlas
# (mongodb+srv://usuario:contraseña@cluster.../noexitrooms)
MONGO_URL=mongodb://127.0.0.1:27017/noexitrooms

# Firma de los tokens JWT: una cadena larga y aleatoria, distinta en cada entorno
TOKEN_PASSWORD=cambia-esto-por-una-cadena-larga
TOKEN_EXPIRES=8h

# URL del frontend que puede llamar a la API (varias separadas por comas).
# 5173 es la web con npm start; 5500, la extensión Live Server de VS Code
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500
