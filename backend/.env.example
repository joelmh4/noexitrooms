# Copia este archivo como .env y rellena los valores. El .env nunca se sube a Git.
PORT=3000

# Base de datos MySQL (en local o el servicio remoto, por ejemplo Aiven)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=noexitrooms
DB_PASSWORD=cambia-esto
DB_NAME=noexitrooms
# true si el proveedor remoto exige conexión cifrada (Aiven)
DB_SSL=false
# Solo si el proveedor usa su propio certificado (Aiven): el contenido de ca.pem, entre comillas
DB_SSL_CA=

# Firma de los tokens JWT: una cadena larga y aleatoria, distinta en cada entorno
TOKEN_PASSWORD=cambia-esto-por-una-cadena-larga
TOKEN_EXPIRES=8h

# URL del frontend que puede llamar a la API (varias separadas por comas).
# 5500 es Live Server de VS Code; 5173, npx serve -l 5173
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://localhost:5173
