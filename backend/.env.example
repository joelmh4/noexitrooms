# Copia este archivo como .env y rellena los valores. El .env nunca se sube a Git.
PORT=3000

# Base de datos MySQL (en local o el servicio remoto)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=noexitrooms
DB_PASSWORD=cambia-esto
DB_NAME=noexitrooms
# true si el proveedor remoto exige conexión cifrada (Aiven, Railway...)
DB_SSL=false

# Firma de los tokens: una cadena larga y aleatoria, distinta en cada entorno
JWT_SECRET=cambia-esto-por-una-cadena-larga
JWT_EXPIRES=8h

# URL del frontend que puede llamar a la API (varias separadas por comas)
CORS_ORIGIN=http://127.0.0.1:5500
